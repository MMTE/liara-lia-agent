    "/v1/workspaces/{workspaceID}/logs": {
      "get": {
        "tags": [
          "Logs"
        ],
        "summary": "List logs",
        "description": "Lists paginated request logs for a workspace. Date range is constrained by the\nworkspace plan's log retention period.\n\nFor image operations, both generations and edits are included when filtering by image routes.",
        "operationId": "listLogs",
        "parameters": [
          {
            "name": "workspaceID",
            "in": "path",
            "required": true,
            "description": "The workspace ID",
            "schema": {
              "type": "string",
              "pattern": "^[a-f0-9]{24}$"
            }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Start date (default: 1 day ago, constrained by plan log retention)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "description": "End date (default: now)",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "model",
            "in": "query",
            "description": "Filter by model ID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "description": "Filter by route",
            "schema": {
              "type": "string",
              "enum": [
                "/chat/completions",
                "/embeddings",
                "/image/generations",
                "/image/edits"
              ],
              "default": "/chat/completions"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "count",
            "in": "query",
            "description": "Items per page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 15
            }
          },
          {
            "name": "key",
            "in": "query",
            "description": "Filter by API key name",
            "schema": {
              "type": "string",
              "minLength": 3,
              "maxLength": 15
            }
          },
          {
            "name": "teamID",
            "in": "query",
            "required": false,
            "description": "Liara team scope — auto-provided by the connection; not a model input.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of logs",
