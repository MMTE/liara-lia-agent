# ── Chat providers (pick with CHAT_PROVIDER) ──────────────────
# vercel  → Vercel AI Gateway (glm-5.2 promo free thru 2026-08-27; ~$5 credit for paid models)
# blackbox → Vercel AI Gateway, glm-5.2 pinned to the Blackbox Eve offer
# liara   → ai.liara.ir (product fallback; OpenAI-compatible)
# avalai  → api.avalai.ir (Iranian aggregator; default for the Liara deployment)
# openrouter → openrouter.ai (tests: :free models; budget: deepseek ~$0.25/M)
# openai  → any OpenAI-compatible API configured below
CHAT_PROVIDER=vercel
CHAT_MODEL=                # optional override per provider (e.g. zai/glm-5.3, deepseek/deepseek-chat-v3.1)
# Explicit fallback chain (overrides the per-provider default):
# "provider:model,provider:model,…" — first healthy entry serves the call,
# failures benched 5 min. Reasoning-first default (2026-08-22 probe):
# gpt-5.6-sol held exact tool args 5/6 vs deepseek v4 variants 1/6.
CHAT_MODEL_CHAIN=
AI_GATEWAY_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1

LIARA_AI_API_KEY=
# workspace id from the Liara AI panel (console.liara.ir/ai → «آیدی») —
# required for chat: the API is workspace-scoped (ai.liara.ir/api/<id>/v1)
LIARA_AI_WORKSPACE_ID=
LIARA_AI_CHAT_MODEL=openai/gpt-4.1-mini
# AI inference connection (chat/embeddings/tts/images as agent tools) needs
# LIARA_AI_API_KEY + LIARA_AI_WORKSPACE_ID (above); without them the agent
# falls back to the AI playground tools (account JWT). The key comes from
# console.liara.ir/ai → keys.

OPENROUTER_API_KEY=
OPENROUTER_BASE=http://127.0.0.1:8787/api/v1
# dev.sh starts Caddy on that base and tunnels openrouter.ai through
# the HTTP proxy on 127.0.0.1:10808.


# ── Liara platform API (agent tools) ───────────────────────────
LIARA_API_BASE=https://api.iran.liara.ir
DEMO_LIARA_TOKEN=

# ── App ────────────────────────────────────────────────────────
PUBLIC_APP_URL=

# ── Liri embed (docs-site fork, ADR-0008) ─────────────────────
# When set, chat citations pointing at docs.liara.ir are rewritten to this
# origin (the vendored docs fork) instead — e.g. http://localhost:3002 in dev.
NEXT_PUBLIC_DOCS_SITE_ORIGIN=

# ── Debug usage meter (ADR-0009) ───────────────────────────────
# Debug-only usage meter strip in chat footer (ADR-0009). Unset = hidden, no
# /api/stats polling. Left commented so template copies don't ship the debug
# strip enabled in production — uncomment locally to use it.
# NEXT_PUBLIC_USAGE_METER=1

# Liara team id (account context for team-scoped API usage) — real value lives in .env only
LIARA_TEAM_ID=
