# ── Chat providers ─────────────────────────────────────────────
CHAT_PROVIDER=vercel            # vercel | liara  (primary; other = fallback)
AI_GATEWAY_API_KEY=             # Vercel AI Gateway key (vck-…), glm-5.2 promo

# Liara AI (fallback chat + embeddings) — from https://ai.liara.ir panel
LIARA_AI_API_KEY=
LIARA_AI_WORKSPACE_ID=
LIARA_AI_CHAT_MODEL=openai/gpt-4o-mini
LIARA_AI_EMBED_MODEL=intfloat/multilingual-e5-large

# ── Liara platform API (agent tools) ───────────────────────────
LIARA_API_BASE=https://api.iran.liara.ir
DEMO_LIARA_TOKEN=               # demo-account API token (demo mode)

# ── App ────────────────────────────────────────────────────────
PUBLIC_APP_URL=                 # set after first deploy
