# ── Chat providers (pick with CHAT_PROVIDER) ──────────────────
# vercel  → Vercel AI Gateway (glm-5.2 promo free thru 2026-08-27; ~$5 credit for paid models)
# liara   → ai.liara.ir (product fallback; OpenAI-compatible)
# openrouter → openrouter.ai (tests: :free models; budget: deepseek ~$0.25/M)
# orca    → api.orcarouter.ai (ephemeral key expires 2026-09-20; deepseek v4 credit)
CHAT_PROVIDER=vercel
CHAT_MODEL=                # optional override per provider (e.g. zai/glm-5.3, deepseek/deepseek-chat-v3.1)
AI_GATEWAY_API_KEY=

LIARA_AI_API_KEY=
LIARA_AI_WORKSPACE_ID=
LIARA_AI_CHAT_MODEL=openai/gpt-4o-mini
LIARA_AI_EMBED_MODEL=intfloat/multilingual-e5-large

OPENROUTER_API_KEY=
OPENROUTER_BASE=https://openrouter.ai/api/v1
# OpenRouter is geo-blocked direct on this network — needs HTTPS_PROXY=http://127.0.0.1:10808

ORCAROUTER_API_KEY=
ORCAROUTER_BASE=https://api.orcarouter.ai/v1

# ── Liara platform API (agent tools) ───────────────────────────
LIARA_API_BASE=https://api.iran.liara.ir
DEMO_LIARA_TOKEN=

# ── App ────────────────────────────────────────────────────────
PUBLIC_APP_URL=
