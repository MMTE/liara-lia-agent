{
  "manifest_version": 3,
  "name": "لیا — ایجنت ابری لیارا",
  "version": "0.2.0",
  "description": "دستیار هوشمند لیارا داخل پنل و سایت لیارا — مستندات، عیب‌یابی و مدیریت منابع ابری.",
  "permissions": ["storage"],
  "host_permissions": ["https://*.liara.ir/*", "https://*.liara.cloud/*"],
  "background": { "service_worker": "background.js" },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "لیا — ایجنت ابری لیارا",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.liara.ir/*", "https://*.liara.cloud/*"],
      "js": ["content.js"],
      "css": ["bubble.css"],
      "run_at": "document_idle"
    }
  ]
}
